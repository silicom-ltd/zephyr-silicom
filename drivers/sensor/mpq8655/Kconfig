config MPQ8655_SENSOR
	bool "MPQ8655 sensors"
	default y
	depends on MPQ8655_VOUT || MPQ8655_IOUT || MPQ8655_VIN || MPQ8655_TEMP
	help
	  Enable sensors for the MPQ8655.

config MPQ8655_VOUT
	bool "MPQ8655 Voltage output"
	default y
	depends on DT_HAS_MPS_MPQ8655_VOUT_ENABLED
	select MFD
	help
	  Enable driver for the MPQ8655 VOUT sensor.

config MPQ8655_IOUT
	bool "MPQ8655 Current output"
	default y
	depends on DT_HAS_MPS_MPQ8655_IOUT_ENABLED
	select MFD
	help
	  Enable driver for the MPQ8655 IOUT sensor.

config MPQ8655_VIN
	bool "MPQ8655 Voltage input"
	default y
	depends on DT_HAS_MPS_MPQ8655_VIN_ENABLED
	select MFD
	help
	  Enable driver for the MPQ8655 VIN sensor.

config MPQ8655_TEMP
	bool "MPQ8655 Temperature reading"
	default y
	depends on DT_HAS_MPS_MPQ8655_TEMP_ENABLED
	select MFD
	help
	  Enable driver for the MPQ8655 TEMP sensor.
