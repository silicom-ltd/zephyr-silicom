# Microchip XEC I2C configuration options

# Copyright (c) 2019 Intel Corporation
# SPDX-License-Identifier: Apache-2.0

config I2C_XEC
	bool "XEC Microchip I2C driver"
	default y
	depends on DT_HAS_MICROCHIP_XEC_I2C_ENABLED
	help
	  Enable the Microchip XEC I2C driver.

config I2C_XEC_V2
	bool "XEC Microchip I2C driver"
	default y
	depends on DT_HAS_MICROCHIP_XEC_I2C_V2_ENABLED
	help
	  Enable the Microchip XEC I2C V2 driver. This driver uses the
	  controller's legacy byte-at-a-time register interface, polling the
	  PIN status bit for every byte transferred. Any instance whose
	  devicetree node has a "dmas" property is claimed by
	  I2C_XEC_V2_NL instead, if that option is also enabled.

config I2C_XEC_V2_NL
	bool "XEC Microchip I2C network-layer (DMA) driver"
	default y
	depends on DT_HAS_MICROCHIP_XEC_I2C_V2_ENABLED
	select DMA
	help
	  Enable the Microchip XEC I2C V2 network-layer driver. This driver
	  uses the controller's hardware Master Command state machine and an
	  external DMA channel to move transaction data, signaling completion
	  with one or two interrupts per transaction instead of polling every
	  byte. It only claims instances whose devicetree node has a "dmas"
	  property (dma-names = "mtr"); instances without one are left for
	  I2C_XEC_V2 to claim.
